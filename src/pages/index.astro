---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLink from '../components/SocialLink.astro';
import StartupCard from '../components/StartupCard.astro';
---

<BaseLayout>
  <main class="page">
    <section class="hero">
      <img src="/images/ismet-ergin.jpg" alt="İsmet Ergin" class="avatar" width="213" height="213" />
      <div class="hero-text">
        <h1>İsmet Ergin</h1>
        <p class="role">Tech Entrepreneur, Dad, Husband</p>
        <p class="tags">#IoT&nbsp;&nbsp; #Hardware&nbsp;&nbsp; #Cloud&nbsp;&nbsp; #Growth&nbsp;&nbsp; #Domaining</p>
        <div class="socials">
          <SocialLink href="https://twitter.com/ismet_ergin" label="X / Twitter">𝕏</SocialLink>
          <SocialLink href="https://www.linkedin.com/in/ismetergin" label="LinkedIn">in</SocialLink>
          <SocialLink href="https://medium.com/@ismetergin" label="Medium">M</SocialLink>
        </div>
      </div>
    </section>

    <section class="startups" aria-labelledby="startups-title">
      <h2 id="startups-title">Startups</h2>
      <div class="cards">
        <StartupCard
          href="https://sixfab.com"
          logoSrc="/images/sixfab-logo-current.png"
          logoAlt="Sixfab"
          description="IoT hardware & connectivity platform"
        />
        <StartupCard
          href="https://www.robotistan.com"
          logoSrc="/images/robotistan-logo.png"
          logoAlt="Robotistan"
          description="Robotics & maker e-commerce"
        />
      </div>
    </section>

    <p class="failed">
      <span class="failed-label">Failed:</span>
      Makerhane (STEM Education), Bomec Garage (Hardware), Pintek (B2B, Mobile App)
    </p>
  </main>
</BaseLayout>

<style>
  .page {
    min-height: 100vh;
    width: min(1120px, calc(100% - 48px));
    padding: clamp(72px, 10vw, 120px) 0 70px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: clamp(80px, 10vw, 118px);
  }

  .hero {
    display: flex;
    gap: clamp(36px, 6vw, 68px);
    align-items: center;
    flex-wrap: wrap;
  }

  .avatar {
    width: 168px;
    height: 168px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    filter: grayscale(1);
    border: 1px solid var(--line-hover);
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 280px;
  }

  h1 {
    margin: 0;
    font-size: clamp(3.25rem, 7vw, 5.2rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -.055em;
  }

  .role {
    margin: 0;
    font-size: clamp(1.15rem, 2vw, 1.45rem);
    font-weight: 500;
  }

  .tags {
    margin: 0;
    font-size: 15px;
    color: var(--text-muted);
  }

  .socials {
    display: flex;
    gap: 13px;
    margin-top: 9px;
  }

  .startups {
    display: flex;
    flex-direction: column;
    gap: 30px;
  }

  .startups h2 {
    margin: 0;
    font-size: 26px;
    font-weight: 600;
    letter-spacing: -.02em;
  }

  .cards {
    display: flex;
    gap: 22px;
    flex-wrap: wrap;
  }

  .failed {
    margin: -35px 0 0;
    font-size: 15px;
    line-height: 1.8;
    color: var(--text-muted);
  }

  .failed-label {
    margin-right: 5px;
    color: var(--accent);
    font-weight: 650;
  }

  @media (max-width: 580px) {
    .page { width: min(100% - 32px, 1120px); }
    .hero { align-items: flex-start; }
    .avatar { width: 132px; height: 132px; }
    .hero-text { min-width: 0; }
  }
</style>
